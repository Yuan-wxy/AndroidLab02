<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="8dp">

    <!-- 垂直辅助线，三分屏幕 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.33"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.66"/>

    <!-- 左侧 Space Stations -->
    <ImageView
        android:id="@+id/imgSat"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/space_station_icon"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guide1"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvTabStation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Space Stations"
        android:textSize="22sp"
        android:textColor="#777777"
        app:layout_constraintTop_toBottomOf="@id/imgSat"
        app:layout_constraintStart_toStartOf="@id/imgSat"
        app:layout_constraintEnd_toEndOf="@id/imgSat"/>

    <!-- 中间 Flights，火箭图片用rocket_icon -->
    <ImageView
        android:id="@+id/imgRocketTab"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/rocket_icon"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="@id/guide1"
        app:layout_constraintEnd_toStartOf="@id/guide2"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvTabFlight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Flights"
        android:textSize="22sp"
        android:textColor="#777777"
        app:layout_constraintTop_toBottomOf="@id/imgRocketTab"
        app:layout_constraintStart_toStartOf="@id/imgRocketTab"
        app:layout_constraintEnd_toEndOf="@id/imgRocketTab"/>

    <!-- 右侧 Rovers -->
    <ImageView
        android:id="@+id/imgRover"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/rover_icon"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="@id/guide2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvTabRover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rovers"
        android:textSize="22sp"
        android:textColor="#777777"
        app:layout_constraintTop_toBottomOf="@id/imgRover"
        app:layout_constraintStart_toStartOf="@id/imgRover"
        app:layout_constraintEnd_toEndOf="@id/imgRover"/>

    <!-- DCA 绿色框 -->
    <TextView
        android:id="@+id/tvDCA"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:text="DCA"
        android:gravity="center"
        android:background="#2e7d32"
        android:textColor="#ffffff"
        android:textSize="28sp"
        app:layout_constraintTop_toBottomOf="@id/tvTabStation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvSwitch"/>

    <!-- 双向交换箭头 -->
    <TextView
        android:id="@+id/tvSwitch"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="⇄"
        android:textSize="32sp"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvTabStation"
        app:layout_constraintStart_toEndOf="@id/tvDCA"
        app:layout_constraintEnd_toStartOf="@id/tvMars"
        app:layout_constraintBottom_toBottomOf="@id/tvDCA"/>

    <!-- MARS绿色框 -->
    <TextView
        android:id="@+id/tvMars"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:text="MARS"
        android:gravity="center"
        android:background="#2e7d32"
        android:textColor="#ffffff"
        android:textSize="28sp"
        app:layout_constraintTop_toBottomOf="@id/tvTabStation"
        app:layout_constraintStart_toEndOf="@id/tvSwitch"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- One Way + Switch开关 -->
    <TextView
        android:id="@+id/tvOneWay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="One Way"
        android:background="#cc7722"
        android:textColor="#ffffff"
        android:padding="10dp"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvDCA"
        app:layout_constraintStart_toStartOf="parent"/>

    <Switch
        android:id="@+id/switchOneWay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvDCA"
        app:layout_constraintStart_toEndOf="@id/tvOneWay"/>

    <!-- 1 Traveller -->
    <TextView
        android:id="@+id/tvTraveller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 Traveller"
        android:background="#cc7722"
        android:textColor="#ffffff"
        android:padding="10dp"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvOneWay"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 星球图片 galaxy -->
    <ImageView
        android:id="@+id/imgPlanet"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/galaxy"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toBottomOf="@id/tvTraveller"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnDepart"/>

    <!-- 火箭图片 rocket_icon -->
    <ImageView
        android:id="@+id/imgRocket"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/rocket_icon"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toBottomOf="@id/tvTraveller"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgPlanet"
        app:layout_constraintBottom_toBottomOf="@id/imgPlanet"/>

    <!-- 底部DEPART按钮，修复绿色背景 -->
    <Button
        android:id="@+id/btnDepart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DEPART"
        android:background="#2e7d32"
        android:backgroundTint="#2e7d32"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
